#!/usr/bin/env bash

# Writes the commit being built into Configurations/commit.local.xcconfig as
# GIT_COMMIT_SHA, which the Flipcash Info.plist reads as FCGitCommit.
#
# Runs as a scheme pre-action (before build settings are read, so the value
# lands in the same build) and from ci_scripts/ci_pre_xcodebuild.sh. It never
# fails the build: when the commit can't be determined the file is left alone
# and base.xcconfig's `unknown` default applies.
#
# Usage: write_commit_xcconfig <source root>

SOURCE_ROOT="$1"

if [ ! -d "$SOURCE_ROOT" ]; then
  echo "warning: No source directory provided: $SOURCE_ROOT. Skipping commit stamp."
  exit 0
fi

OUTPUT="$SOURCE_ROOT/Configurations/commit.local.xcconfig"

# Xcode Cloud names the commit it checked out. Its clone is never dirty, so the
# dirty check is skipped there rather than trusted to a working tree CI may
# have touched (package resolution, generated plists).
if [ -n "$CI_COMMIT" ]; then
  COMMIT="$CI_COMMIT"
  DIRTY=""
else
  COMMIT=$(git -C "$SOURCE_ROOT" rev-parse HEAD 2>/dev/null)
  if [ -n "$(git -C "$SOURCE_ROOT" status --porcelain 2>/dev/null)" ]; then
    DIRTY="-dirty"
  else
    DIRTY=""
  fi
fi

if ! [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
  echo "warning: Could not determine the git commit. The build will report 'unknown'."
  rm -f "$OUTPUT"
  exit 0
fi

CONTENT="GIT_COMMIT_SHA = $COMMIT$DIRTY"

# Rewriting an unchanged file would still bump its timestamp and invalidate
# the Info.plist step on every build.
if [ -f "$OUTPUT" ] && [ "$(cat "$OUTPUT")" = "$CONTENT" ]; then
  exit 0
fi

echo "$CONTENT" > "$OUTPUT"
echo "Stamped $COMMIT$DIRTY"
