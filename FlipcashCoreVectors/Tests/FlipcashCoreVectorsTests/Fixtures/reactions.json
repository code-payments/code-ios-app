{
  "defaults": [
    "❤️",
    "👍",
    "😂",
    "😮",
    "😢",
    "🔥"
  ],
  "merge": [
    {
      "name": "summary-renders",
      "self": "me",
      "steps": [
        {
          "op": "summary",
          "reactions": [
            {
              "emoji": "👍",
              "count": 2,
              "self": false,
              "version": 4
            },
            {
              "emoji": "🔥",
              "count": 1,
              "self": true,
              "version": 1
            }
          ]
        }
      ],
      "expect": {
        "pills": [
          {
            "emoji": "👍",
            "count": 2,
            "selfReacted": false,
            "pending": false
          },
          {
            "emoji": "🔥",
            "count": 1,
            "selfReacted": true,
            "pending": false
          }
        ],
        "calls": [],
        "errors": []
      },
      "note": "A summary alone. Counts as given; self from self_reactor."
    },
    {
      "name": "stale-update-dropped",
      "self": "me",
      "steps": [
        {
          "op": "summary",
          "reactions": [
            {
              "emoji": "👍",
              "count": 3,
              "self": false,
              "version": 7
            }
          ]
        },
        {
          "op": "update",
          "emoji": "👍",
          "actor": "ana",
          "action": "REMOVED",
          "count": 2,
          "version": 6
        }
      ],
      "expect": {
        "pills": [
          {
            "emoji": "👍",
            "count": 3,
            "selfReacted": false,
            "pending": false
          }
        ],
        "calls": [],
        "errors": []
      },
      "note": "Version 6 is below the held 7, so it is an update the summary already folded in."
    },
    {
      "name": "equal-version-dropped",
      "self": "me",
