{
  "algorithm": "text-format",
  "note": "Chat text formatting carried as markup in TextContent.text. Input: `text` and the `ranges` (links and mentions) detection found in it (UTF-16, half-open, raw offsets); markers inside a range are literal. Output: `display` (consumed markers removed), `spans` over display, and `displayRanges` (the input ranges at display offsets). Spans are normalized: per style, touching or overlapping runs are merged; ordered by start, then longest first, then style. Behavior parity, not a computation with an external reference.",
  "styles": [
    "bold",
    "italic",
    "strike",
    "code",
    "codeBlock",
    "quote",
    "bullet",
    "numbered"
  ],
  "vectors": [
