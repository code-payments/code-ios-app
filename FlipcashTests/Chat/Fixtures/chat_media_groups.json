{
  "algorithm": "chat-media-groups",
  "note": "Client-side card-stack grouping for docs/superpowers/specs/2026-11-04-chat-media-design.md (C2). Input is one chat's messages in seq order. A stack is a maximal run of 2 or more messages where every message is a photo from the same sender, each seq is the previous seq + 1, each ts is within windowSeconds of the previous (inclusive), only the first may be a reply, and only the last may have a caption. Messages not listed in a stack draw as today. Group greedily from the oldest message.",
  "windowSeconds": 2.0,
  "cases": [
    {
      "name": "clean-set",
      "note": "Five photos sent together, caption on the last.",
      "messages": [
        {
          "seq": 1,
          "sender": "a",
          "kind": "photo",
          "ts": 0,
          "hasCaption": false,
          "isReply": false
        },
        {
          "seq": 2,
          "sender": "a",
          "kind": "photo",
          "ts": 0.4,
          "hasCaption": false,
          "isReply": false
        },
        {
          "seq": 3,
          "sender": "a",
          "kind": "photo",
          "ts": 0.8,
          "hasCaption": false,
          "isReply": false
        },
        {
          "seq": 4,
          "sender": "a",
          "kind": "photo",
          "ts": 1.2,
          "hasCaption": false,
          "isReply": false
        },
        {
          "seq": 5,
          "sender": "a",
          "kind": "photo",
          "ts": 1.6,
          "hasCaption": true,
          "isReply": false
        }
      ],
      "stacks": [
        [
          1,
          2,
          3,
          4,
          5
        ]
      ]
    },
    {
